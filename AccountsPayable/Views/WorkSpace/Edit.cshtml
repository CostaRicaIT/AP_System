@model AccountsPayable.Models.TB_WORKSPACE

@{
    ViewBag.Title = "AP Workspace | Edit";
}
<link href="~/Content/Style.css" rel="stylesheet" />
<link href="~/Content/TemplateModal.css" rel="stylesheet" />

<h2> </h2>
<label hidden id="templateId">@Model.TEMP_ID</label>
<br />

<form id="form">
    <!-- Workspace Section -->
    <div class="form-section">
        <div class="section-title">Workspace</div>

        <!-- Tax ID -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="TEMP_TAX_ID" class="control-label col-md-2">Tax ID:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_TAX_ID, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.WS_TEMP_TAX_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Status -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Status" class="control-label col-md-2">Status:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Status">
                    </div>
                </div>
            </div>
        </div>

        <!-- Reason -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Reason" class="control-label col-md-2">Reason:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Reason">
                    </div>
                </div>
            </div>
        </div>

        <!-- Email Received -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Email Received" class="control-label col-md-2">Email Received:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Email Received">
                    </div>
                </div>
            </div>
        </div>

        <!-- Created Date -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Create Date" class="control-label col-md-2">Create Date:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Create Date">
                    </div>
                </div>
            </div>
        </div>

        <!-- Source -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Source" class="control-label col-md-2">Source:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Source">
                    </div>
                </div>
            </div>
        </div>

        <!-- Handled By -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Handled By" class="control-label col-md-2">Handled By:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Handled By">
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoice Date -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Invoice Date" class="control-label col-md-2">Invoice Date:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Invoice Date">
                    </div>
                </div>
            </div>
        </div>

        <!-- Due Date -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Due Date" class="control-label col-md-2">Due Date:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Due Date">
                    </div>
                </div>
            </div>
        </div>

        <!-- Amount -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Amount" class="control-label col-md-2">Amount:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Amount">
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoice Number -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Invoice Number" class="control-label col-md-2">Invoice Number:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-">
                    </div>
                </div>
            </div>
        </div>
        <!-- Comments -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-Comments">Comments:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-Comments" rows="6" cols="50"></textarea>
                        <br />
                    </div>
                </div>
            </div>

        </div>

        <!-- Last Actions -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-Last Actions">Last Action:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-Last Action" rows="6" cols="50"></textarea>
                        <br />
                    </div>
                </div>
            </div>

        </div>
    </div>
    <br>

    <!-- Supplier Information Section -->
    <div class="form-section">
        <div class="section-title">Supplier Information</div>

        <!-- Folder -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="TEMP_FOLDER" class="control-label col-md-2">Folder:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_FOLDER, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>



        <!-- Supplier Name -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_SUPPLIER_NAME">Supplier Name:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_SUPPLIER_NAME, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.WS_TEMP_SUPPLIER_NAME, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Supplier Number -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_SUPPLIER_NUMBER">Supplier Number:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_SUPPLIER_NUMBER, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.WS_TEMP_SUPPLIER_NUMBER, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Remit To -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_REMIT_TO">Remit to:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_REMIT_TO, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.WS_TEMP_REMIT_TO, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Supplier Site -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_SUPPLIER_SITE">Supplier Site:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_SUPPLIER_SITE, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.WS_TEMP_SUPPLIER_SITE, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Historic Remit To -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TB_HISTORIC_REMIT1_HISTORIC_REMIT_INFO">Historic Remit To:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TB_HISTORIC_REMIT.HISTORIC_REMIT_INFO, new { @class = "form-control TinyEditor", @rows = 5, @cols = 50 })
                        @Html.ValidationMessageFor(model => model.TB_HISTORIC_REMIT.HISTORIC_REMIT_INFO, "", new { @class = "text-danger" })
                        <br />
                    </div>
                </div>

                <div class="col-md-4">
                    @*<button id="ButtonAddHistoricRemit" type="button" class="styled-button align-right btn-submit" disabled>Add Historic Remit to</button>*@
                    <button id="ButtonViewHisticRemit" type="button" class="styled-button align-right openModalBtn" data-modal="ShowHistoricRemitModal">View Historic Remit to</button>
                </div>
            </div>
            <!--Modal to see historic remit -->
            <div id="ShowHistoricRemitModal" class="modal">
                <div class="modal-content">
                    <span id="cancelButton" class="close">&times;</span>
                    <div class="row">
                        <div class="control-label col-md-12">
                            <label class="control-label col-md-4" for="historicRemitInfoView">Historic Remit to:</label>
                            <div class="col-md-10">
                                <textarea class="form-control TinyEditorReadOnly" id="historicRemitInfoView" rows="6" cols="75"></textarea>
                                <br />
                            </div>
                        </div>
                    </div>
                    <!--Select Historic Remit to -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-6">
                                @Html.DropDownList("WS_FK_TB_TEMPLATE_HISTORIC_REMIT_ID", null, htmlAttributes: new { @class = "form-control", @size = "5" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Our Vendor # / Account # -->
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label class="control-label col-md-2" for="TEMP_VENDOR_ACCOUNT" id="label-OurVendorA">OUR VENDOR #/ ACCOUNT #:</label>
                        <div class="col-md-10">
                            @Html.TextAreaFor(model => model.WS_TEMP_VENDOR_ACCOUNT, new { @class = "form-control", @rows = 5, @cols = 50 })
                            @Html.ValidationMessageFor(model => model.WS_TEMP_VENDOR_ACCOUNT, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>

            <!-- Source -->
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.WS_FK_TB_ORACLE_SOURCE_ID, "Source:", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownList("WS_FK_TB_ORACLE_SOURCE_ID", null, htmlAttributes: new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.WS_FK_TB_ORACLE_SOURCE_ID, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            </div>
        </div>.
    </div>
    <br />

    <!-- Alias Section -->
    <div class="form-section">
        <div class="section-title">Alias</div>
        <!-- Alias Input and Button-->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-AddAlias">Alias:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-AddAlias">
                    </div>
                </div>
                <div class="col-md-6">
                    <button id="btn-addAlias" type="button" class="styled-button align-right">Add alias</button>
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="FK_TB_TEMPLATE_ALIAS_ID"></label>
                    <div class="col-md-7">
                        @Html.DropDownList("WS_FK_TB_TEMPLATE_ALIAS_ID", null, htmlAttributes: new { @class = "form-control", @size = "5" })
                    </div>
                </div>
            </div>

            <!--Select Alias Dropdown-->
        </div>
    </div>
    <br />

    <!-- Invoice Number Format Section -->
    <div class="form-section">
        <div class="section-title">Invoice Number Format</div>
        <!-- Approver info -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_INVOICE_FORMAT">Invoice Format:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_INVOICE_FORMAT, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.WS_TEMP_INVOICE_FORMAT, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Type -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_INVOICE_TYPE">Type:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_INVOICE_TYPE, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.WS_TEMP_INVOICE_TYPE, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoice Notes -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_INVOICE_NOTES" id="label-InvoiceNotes">Invoice Notes:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.WS_TEMP_INVOICE_NOTES, new { @class = "form-control TinyEditor", @rows = 5, @cols = 50 })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Forms Section -->
    <div class="form-section">
        <div class="section-title">Forms</div>
        <!-- W9/W-8BEN Form -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_W9_W8" id="label-W9/W-8BEN">W9/W-8BEN Form:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.WS_TEMP_W9_W8, new { @class = "form-control TinyEditor", @rows = 5, @cols = 50 })
                    </div>
                </div>
            </div>
        </div>

        <!-- VSU Form -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_VSU" id="label-VSU">VSU Form:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.WS_TEMP_VSU, new { @class = "form-control TinyEditor", @rows = 5, @cols = 50 })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Oracle and Apps Section -->
    <div class="form-section">
        <div class="section-title">Oracle and Apps</div>

        <!-- Payment Method -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_PAYMENT_METHOD">Payment Method:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_PAYMENT_METHOD, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>

        <!-- Remit-To Account -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_REMIT_TOACCOUNT">Remit-To Account:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_REMIT_TOACCOUNT, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>

        <!-- Pay Terms -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.WS_FK_TB_ORACLE_PAY_TERMS_ID, "Payment Terms:", htmlAttributes: new { @class = "control-label col-md-2 OracleText" })
                    <div class="col-md-10">
                        @Html.DropDownList("WS_FK_TB_ORACLE_PAY_TERMS_ID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.WS_FK_TB_ORACLE_PAY_TERMS_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoice Description -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_INVOICE_DESCRIPTION">Invoice Description:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_INVOICE_DESCRIPTION, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>

        <!-- Billing Period and Dates -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_BILLING_PERIOD">Billing Period:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.WS_TEMP_BILLING_PERIOD, new { @class = "form-control TinyEditor", @rows = 5, @cols = 50 })
                    </div>
                </div>
                <!-- Dates -->
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-Dates" id="dates">Dates:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_BILLING_PERIOD_DATE, new { htmlAttributes = new { @class = "form-control", @id = "form-Dates" } })
                    </div>
                </div>
            </div>
        </div>

        <!-- Distribution Set -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_DISTRIBUTION_SET">Distribution Set:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_DISTRIBUTION_SET, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>

        <!-- Distribution Combination -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_DISTRIBUTION_COMBINATION">Distribution Combination:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_DISTRIBUTION_COMBINATION, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>

        <!-- Accounting Date -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_ACCOUNTING_DATE">Accounting Date:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.WS_TEMP_ACCOUNTING_DATE, new { htmlAttributes = new { @class = "form-control" } })
                    </div>
                </div>
            </div>
        </div>

        <!-- Legal Entity -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="FK_TB_LEGAL_ENTITY_ID">Legal Entity:</label>
                    <div class="col-md-10">
                        @Html.DropDownList("WS_FK_TB_LEGAL_ENTITY_ID", null, htmlAttributes: new { @class = "form-control", @id = "legalEntityDropdown" })
                        @Html.ValidationMessageFor(model => model.WS_FK_TB_LEGAL_ENTITY_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <button class="styled-button openModalBtn" data-modal="ShowLegalEntityModal" type="button" id="form-legalEntity">Add a new Legal Entity</button>
                </div>
            </div>
        </div>

        <!-- Add a new legal entity modal-->
        <div id="ShowLegalEntityModal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title">Legal Entity</h4>
                </div>

                <div class="modal-body">
                    <!-- Legal Entity Section-->
                    <div class="form-group">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="control-label col-md-6" for="form-AddLegalEntity">Legal Entity:</label>
                                <div class="col-md-10">
                                    <input type="text" class="form-control" id="form-AddLegalEntity" placeholder="Legal Entity" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <button class="styled-button" type="button" id="btn-addLegalEntity">Add a new Legal Entity</button>
                            </div>
                        </div>
                        <br />
                    </div>
                </div>
            </div>
        </div>
        <!-- Organization Type -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="FK_TB_ORGANIZATION_TYPE_ID">Organization Type:</label>
                    <div class="col-md-10">
                        @Html.DropDownList("WS_FK_TB_ORGANIZATION_TYPE_ID", null, htmlAttributes: new { @class = "form-control", @id = "organizationTypeDropdown" })
                        @Html.ValidationMessageFor(model => model.WS_FK_TB_ORGANIZATION_TYPE_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <button class="styled-button openModalBtn" data-modal="ShowOrganizationTypeModal" type="button" id="form-OrganizationType">Add a new Organization Type</button>
                </div>
            </div>
        </div>

        <!-- Add a new organization type modal-->
        <div id="ShowOrganizationTypeModal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title">Organization Type</h4>
                </div>

                <div class="modal-body">
                    <!-- Organization Type Section-->
                    <div class="form-group">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="control-label col-md-6" for="form-AddOrganizationType">Organization Type:</label>
                                <div class="col-md-10">
                                    <input type="text" class="form-control" id="form-AddOrganizationType" placeholder="Organization Type" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <button class="styled-button" type="button" id="btn-AddOrganizationType">Add a new Organization Type</button>
                            </div>
                        </div>
                        <br />
                    </div>
                </div>
            </div>
        </div>

        <!-- First-Party Taxpayer ID -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_TAXPAYER_ID">Taxpayer ID:</label>
                    <div class="col-md-10">
