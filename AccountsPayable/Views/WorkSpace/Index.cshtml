@model IEnumerable<AccountsPayable.Models.TB_WORKSPACE>
@using AccountsPayable.Models

@{
    ViewBag.Title = "AP Workspace | Dashboard";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />
<link rel="stylesheet" href="~/Content/table.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/staterestore/1.3.0/css/stateRestore.dataTables.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<div class="container">
    <p>
        @if (Session["Permission"] != null && ((TB_VIEW_PERMISSIONS)Session["Permission"]).FK_TB_LOGIN_ROLE_ID == 2)
        {
            <button class="btn-primary" type="submit">@Html.ActionLink("Create New", "Create")</button>
        }
    </p>
    <table id="dataTable" class="table cell-border stripe display" width="100%">
        <thead>
            <tr>
                <th>ID</th>
                <th>Alias</th>
                <th>Folder</th>
                <th>Tax ID</th>
                <th>Supplier Name</th>
                <th>Supplier Number</th>
                <th>Remit To</th>
                <th>Supplier Site</th>
                <th>Histoic Remit to</th>
                <th>Vendor Account</th>
                <th>Source</th>
                <th>Invoice Format</th>
                <th>Invoice Type</th>
                <th>Invoice Notes</th>
                <th>W9/W-8BEN Form</th>
                <th>VSU Form</th>
                <th>Payment Method</th>
                <th>Remit-To Account</th>
                <th>Pay Terms</th>
                <th>Invoice Description</th>
                <th>Billing Period</th>
                <th>Dates</th>
                <th>Distribution Set</th>
                <th>Distribution Combination</th>
                <th>Accounting Date</th>
                <th>Legal Entity</th>
                <th>Organization Type</th>
                <th>Tax Payer ID</th>
                <th>Type</th>
                <th>Description</th>
                <th>Oracle Notes</th>
                <th>Oracle Instructions</th>
                <th>AR Key Contacts/Currents</th>
                <th>AR Key Contacts/Prior</th>
                <th>Approver</th>
                <th>Approver Comments</th>
                <th>Email Backup</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.WS_ID</td>
                    <td class="alias">@item.WS_FK_TB_TEMPLATE_ALIAS_ID</td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_FOLDER
                        </div>
                    </td>
                    <td class="tax">@item.WS_TEMP_TAX_ID </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_SUPPLIER_NAME
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_SUPPLIER_NUMBER
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_REMIT_TO
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_SUPPLIER_SITE
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @Html.Raw(item.WS_FK_TB_TEMPLATE_HISTORIC_REMIT_ID)
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_VENDOR_ACCOUNT
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.TB_ORACLE_SOURCE.ORACLE_SOURCE_DESCRIPTION
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_INVOICE_FORMAT
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_INVOICE_TYPE
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @Html.Raw(item.WS_TEMP_INVOICE_NOTES)
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @Html.Raw(item.WS_TEMP_W9_W8)
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @Html.Raw(item.WS_TEMP_VSU)
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_PAYMENT_METHOD
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_REMIT_TOACCOUNT
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.TB_ORACLE_PAY_TERMS.PAY_TERMS_DESCRIPTION
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_INVOICE_DESCRIPTION
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @Html.Raw(item.WS_TEMP_BILLING_PERIOD)
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_BILLING_PERIOD_DATE
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_DISTRIBUTION_SET
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_DISTRIBUTION_COMBINATION
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_ACCOUNTING_DATE
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.TB_ORACLE_LEGAL_ENTITIES.LEGAL_ENTITY_NAME
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @(string.IsNullOrEmpty(item.TB_ORACLE_ORGANIZATION_TYPE?.ORGANIZATION_TYPE_NAME) ? "" : item.TB_ORACLE_ORGANIZATION_TYPE.ORGANIZATION_TYPE_NAME)
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_TAXPAYER_ID
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.TB_ORACLE_TYPE.ORACLE_TYPE_NAME
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @Html.Raw(item.WS_TEMP_ORACLE_DESCRIPTION)
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @Html.Raw(item.WS_TEMP_ORACLE_NOTES)
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @Html.Raw(item.WS_TEMP_ORACLE_INSTRUCTIONS)
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_CONTACTS_CURRENT
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_CONTACTS_PRIOR
                        </div>
                    </td>
                    <td>@item.TB_APPROVER.APPROVER_NAME</td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_TEMP_APPROVER_COMMENTS
                        </div>
                    </td>
                    <td>
                        <div class="scrollable-content">
                            @item.WS_FK_TB_EMAIL_BACKUP_ID
                        </div>
                    </td>
                    <td>
                        <div class="button-container">


                            @if (Session["Permission"] != null && ((TB_VIEW_PERMISSIONS)Session["Permission"]).FK_TB_LOGIN_ROLE_ID == 3)
                            {
                                <button class="dt-button filterButton view-button" data-id="@item.TEMP_ID"><i class="fa-solid fa-eye"></i></button>
                            }

                            else
                            {
                                <button class="dt-button filterButton view-button" data-id="@item.TEMP_ID"><i class="fa-solid fa-eye"></i></button>
                                <button class="dt-button filterButton edit-button" data-id="@item.TEMP_ID"><i class="fas fa-edit"></i></button>
                                <button class="dt-button filterButton erase-button" data-id="@item.TEMP_ID"><i class="fa-solid fa-eraser"></i></button>
                            }

                        </div>
                    </td>

                </tr>
            }
        </tbody>

    </table>

</div>
