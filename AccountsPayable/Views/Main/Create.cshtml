    <!-- Oracle and Apps Section -->
    <div class="form-section">
        <div class="section-title">Oracle and Apps</div>
        <!-- Supplier Number -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-SupNumber">Supplier Number:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-SupNumber" placeholder="Supplier Number" required>
                    </div>
                </div>
            </div>
        </div>
        <!-- Supplier Site -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-SupSite">Supplier Site:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-SupSite" placeholder="Supplier Site" required>
                    </div>
                </div>
            </div>
        </div>
        <!-- Address -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-Address">Address:</label>
                    <div class="col-md-10">
                        <textarea id="form-Address" class="form-control" placeholder="Address" rows="6" cols="50" required></textarea>
                    </div>
                </div>
            </div>
        </div>
        <!-- Legal Entity -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="FK_TB_LEGAL_ENTITY_ID">Legal Entity:</label>
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_LEGAL_ENTITY_ID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.FK_TB_LEGAL_ENTITY_ID, "", new { @class = "text-danger"})
                    </div>
                </div>
            </div>
        </div>
        <!-- First-Party Taxpayer ID -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-FirstParty">Taxpayer ID:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-FirstParty" placeholder="Taxpayer ID" required>
                    </div>
                </div>
            </div>
        </div>
        <!-- Type -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_ORACLE_TYPE_ID, "Type:", htmlAttributes: new { @class = "control-label col-md-2 OracleText" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_ORACLE_TYPE_ID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.FK_TB_ORACLE_TYPE_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Description -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-Description">Description:</label>
                    <div class="col-md-10">
                        <textarea id="form-Description" class="form-control" placeholder="Description" rows="6" cols="50" required></textarea>
                    </div>
                </div>
            </div>
        </div>
        <!-- Pay Terms -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_ORACLE_PAY_TERMS_ID, "Pay Terms:", htmlAttributes: new { @class = "control-label col-md-2 OracleText" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_ORACLE_PAY_TERMS_ID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.FK_TB_ORACLE_PAY_TERMS_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Account Coding -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-AccountC">Account Coding:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-AccountC" placeholder="Account Coding" required>
                    </div>
                </div>
            </div>
        </div>
        <!-- Source -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_ORACLE_SOURCE_ID, "Source:", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_ORACLE_SOURCE_ID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.FK_TB_ORACLE_SOURCE_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Oracle Notes -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-OracleN">Oracle Notes:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-OracleN" rows="6" cols="50" placeholder="Oracle Notes" required></textarea>
                    </div>
                </div>
                <!-- Oracle Instructions -->
                <div class="col-md-6">
                    <label class="control-label col-md-2 checkbox-label" for="form-OracleI" id="Label-Oracle">Oracle Instructions:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-OracleI" rows="6" cols="50" placeholder="Oracle instructions" required></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Notes & Instructions Section -->
    <div class="form-section">
        <div class="section-title">Notes & Instructions</div>
        <!-- Highlights -->
        <div class="form-group">
            <div class="row">
