@model AccountsPayable.Models.TB_TEMPLATE

@{
    ViewBag.Title = "AP Templates | Create";
}

<h2> </h2>
<br />
<link href="~/Content/Style.css" rel="stylesheet" />
<link href="~/Content/TemplateModal.css" rel="stylesheet" />

<form id="form">

    <!-- Supplier Information Section -->
    <div class="form-section">
        <div class="section-title">Supplier Information</div>

        <!-- Folder -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Folder" class="control-label col-md-2">Folder:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Folder">
                    </div>
                </div>
            </div>
        </div>

        <!-- Tax ID -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-TaxID" class="control-label col-md-2">Tax Id:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-TaxID">
                    </div>
                </div>
            </div>
        </div>

        <!-- Supplier Name -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-SupName">Supplier Name:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-SupName">
                    </div>
                </div>
            </div>
        </div>

        <!-- Supplier Number -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-SupNumber">Supplier Number:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-SupNumber">
                    </div>
                </div>
            </div>
        </div>

        <!-- Remit To -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-RemitTo">Remit to:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-RemitTo">
                    </div>
                </div>
            </div>
        </div>

        <!-- Supplier Site -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-SupSite">Supplier Site:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-SupSite">
                    </div>
                </div>
            </div>
        </div>

        <!-- Historic Remit To -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-HistRemitTo">Historic Remit To:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-HistRemitTo" rows="6" cols="50"></textarea>
                        <br />
                    </div>
                </div>
            </div>
        
            <!-- Our Vendor # / Account # -->
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label class="control-label col-md-2" for="form-OurVendorA" id="label-OurVendorA">OUR VENDOR #/ ACCOUNT #:</label>
                        <div class="col-md-10">
                            <textarea class="form-control" id="form-OurVendorA" rows="6" cols="50"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Source -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_ORACLE_SOURCE_ID, "Source:", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_ORACLE_SOURCE_ID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.FK_TB_ORACLE_SOURCE_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

    </div>
    <br />

    <!-- Invoice Number Format Section -->
    <div class="form-section">
        <div class="section-title">Invoice Number Format</div>
        <!-- Approver info -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-InvoiceF">Invoice Format:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-InvoiceF">
                    </div>
                </div>
            </div>
        </div>
        <!-- Type -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-INFType">Type:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-INFType">
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoice Notes -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-InvoiceNotes" id="label-InvoiceNotes">Invoice Notes:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-InvoiceNotes" rows="6" cols="50"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Forms Section -->
    <div class="form-section">
        <div class="section-title">Forms</div>
        <!-- W9/W-8BEN Form -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-W9W8" id="label-W9/W-8BEN">W9/W-8BEN Form:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-W9W8" rows="6" cols="50"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- VSU Form -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-VSU" id="label-VSU">VSU Form:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-VSU" rows="6" cols="50"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

   
    <!-- Oracle and Apps Section -->
    <div class="form-section">
        <div class="section-title">Oracle and Apps</div>

        <!-- Payment Method -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-PayMethod">Payment Method:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-PayMethod">
                    </div>
                </div>
            </div>
        </div>

        <!-- Remit-To Account -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-RemitToAccount">Remit-To Account:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-RemitToAccount">
                    </div>
                </div>
            </div>
        </div>

        <!-- Pay Terms -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_ORACLE_PAY_TERMS_ID, "Pay Terms:", htmlAttributes: new { @class = "control-label col-md-2 OracleText" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_ORACLE_PAY_TERMS_ID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.FK_TB_ORACLE_PAY_TERMS_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoice Description -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-InvoiceDescrip">Invoice Description:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-InvoiceDescrip">
                    </div>
                </div>
            </div>
        </div>

        <!-- Billing Period -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-BillPeriod">Billing Period:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-BillPeriod"></textarea>
                    </div>
                </div>

                <!-- Dates -->
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-Dates" id="dates">Dates:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Dates">
                    </div>
                </div>
            </div>
        </div>

        <!-- Distribution Set -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-DistroSet">Distribution Set:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-DistroSet">
                    </div>
                </div>
            </div>
        </div>

        <!-- Distribution Combination -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-DistroCombination">Distribution Combination:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-DistroCombination">
                    </div>
                </div>
            </div>
        </div>

        <!-- Accounting Date -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-AccoDate">Accounting Date:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-AccoDate">
                    </div>
                </div>
            </div>
        </div>

        <!-- Legal Entity -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="FK_TB_LEGAL_ENTITY_ID">Legal Entity:</label>
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_LEGAL_ENTITY_ID", null, htmlAttributes: new { @class = "form-control", @id = "legalEntityDropdown" })
                        @Html.ValidationMessageFor(model => model.FK_TB_LEGAL_ENTITY_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <button class="styled-button openModalBtn" data-modal="ShowLegalEntityModal" type="button" id="form-legalEntity">Add a new Legal Entity</button>
                </div>
            </div>
        </div>

        <!-- Add a new legal entity modal-->
        <div id="ShowLegalEntityModal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title">Legal Entity</h4>
                </div>

                <div class="modal-body">
                    <!-- Legal Entity Section-->
                    <div class="form-group">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="control-label col-md-6" for="form-AddLegalEntity">Legal Entity:</label>
                                <div class="col-md-10">
                                    <input type="text" class="form-control" id="form-AddLegalEntity" placeholder="Legal Entity" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <button class="styled-button" type="button" id="btn-addLegalEntity">Add a new Legal Entity</button>
                            </div>
                        </div>
                        <br />
                    </div>
                </div>
            </div>
        </div>

        <!-- First-Party Taxpayer ID -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-FirstParty">Taxpayer ID:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-FirstParty">
                    </div>
                </div>
            </div>
        </div>
        <!-- Type -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_ORACLE_TYPE_ID, "Type:", htmlAttributes: new { @class = "control-label col-md-2 OracleText" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_ORACLE_TYPE_ID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.FK_TB_ORACLE_TYPE_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Description -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-Description">Description:</label>
                    <div class="col-md-10">
                        <textarea id="form-Description" class="form-control TinyEditor" rows="6" cols="50"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Oracle Notes -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-OracleN">Oracle Notes:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-OracleN" rows="6" cols="50"></textarea>
                    </div>
                </div>
                <!-- Oracle Instructions -->
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="form-OracleI" id="Label-Oracle">Oracle Instructions:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-OracleI" rows="6" cols="50"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Contacts -->
    <div class="form-section">
        <div class="section-title">Contacts</div>
        <div class="form-group">
            <div class="row">

                <!-- AR Key Contacts/Currents -->
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-Currents">AR Key Contacts/Currents:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-Currents" rows="6" cols="50"></textarea>
                    </div>
                </div>

                <!-- AR Key Contacts/Prior -->
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-Prior">AR Key Contacts/Prior:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-Prior" rows="6" cols="50"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <br />

    <!-- Notes & Instructions Section -->
    <div class="form-section">
        <div class="section-title">Notes & Instructions</div>
        <!-- Highlights -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="form-Higlights">Highlights</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-Higlights" rows="8" cols="150"></textarea>
                    </div>
                </div>
                </div>
            </div>
        </div>
        <!-- Highlights Comments -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="form-HiglightsC">Highlights Comments:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-HiglightsC" rows="8" cols="150"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <!-- Instructions -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="form-Instructions">Instructions:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-Instructions" rows="8" cols="150"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <!-- Exceptions -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="form-Exceptions">Exceptions:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-Exceptions" rows="8" cols="150"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <!-- Most Common Issues -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="form-MostCI">Most Common <br> Issues:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-MostCI" rows="8" cols="150"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <!-- Supplier Agency -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="form-SupplierA">Supplier Agency:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-SupplierA" rows="8" cols="150"></textarea>
                    </div>
                </div>
            </div>
        </div>
        <!-- Template Comments -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="form-TemplateC">Template Comments:</label>
                    <div class="col-md-10">
                        <textarea class="form-control TinyEditor" id="form-TemplateC" rows="8" cols="150"></textarea>
                    </div>
                </div>
            </div>
        </div>
    <br />
    <br />
    <!-- Approver Section -->
    <div class="form-section">
        <div class="section-title">Approver</div>
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_APPROVER_ID, "Approver:", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_APPROVER_ID", null, htmlAttributes: new { @class = "form-control", @id = "approverDropdown" })
                        @Html.ValidationMessageFor(model => model.FK_TB_APPROVER_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <button class="styled-button openModalBtn" data-modal="ShowApproverModal" type="button" id="form-approver">Add a new Approver</button>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-ApproverComents">Aprover Comments:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-ApproverComents" rows="6" cols="120"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!--Add a new approver modal-->
        <div id="ShowApproverModal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title">Approver</h4>
                </div>

                <div class="modal-body">
                    <!-- Approver Section-->
                    <div class="form-group">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="control-label col-md-6" for="form-AddApprover">Approver:</label>
                                <div class="col-md-10">
                                    <input type="text" class="form-control" id="form-AddApprover" placeholder="Approver" />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <button class="styled-button" type="button" id="btn-addAppover">Add a new approver</button>
                            </div>
                        </div>
                        <br />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Cancel and Save Buttons -->
    <button class="btn form_btntbWC btn-cancel" type="button" id="form-cancel">Cancel</button>
    <button class="btn form_btntbWC openModalBtn" data-modal="ShowSaveModal" type="button" id="form-submit">Save</button>

    <!--Save Changes modal-->
    <div id="ShowSaveModal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Save Changes</h4>
                <button type="button" id="cancelButton" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <div class="row">

                        <h4 class="text-center">
                            Would you like to add additional information to the template: <br />
                            Alias / Backup Emails?
                        </h4>
                        <br />
                        <div style="display: flex; justify-content: center; gap: 10vw;">
                            <button class="btn form_btntbWC openModalBtn" data-modal="ShowAddAlias_EmailModal" type="button" id="AddAlias_Emailbtn">Yes</button>
                            <button class="btn form_btntbWC" type="button" id="NoAddAlias_Emailbtn">No</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Add alias / Backup emails modal-->
    <div id="ShowAddAlias_EmailModal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Alias and Backup email's information</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!--Alias section-->
                <div class="form-group">
                    <div class=" row">
                        <div class="col-md-6">
                            <label class="control-label col-md-6" for="form-AddAlias">Alias:</label>
                            <div class="col-md-10">
                                <input type="text" class="form-control" id="form-AddAlias" placeholder="Alias name">

                            </div>
                        </div>
                        <div class="col-md-4">
                            <br />
                            <button class="btn form_btntbWC" type="button" id="btn-addAlias">Add Alias</button>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-10">
                                <select name="Alias" id="FK_TB_TEMPLATE_ALIAS_ID" class="form-control" size="5">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <br />

                <!--Email section-->
                <div class="form-group">
                    <div class=" row">
                        <div class="col-md-6">
                            <label class="control-label col-md-8" for="form-BackUpEmail">Back Up Emails:</label>
                            <div class="col-md-10">
                                <textarea class="form-control" id="form-BackUpEmail" placeholder="Backup email" rows="5" cols="100"></textarea>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <br />
                            <button id="ButtonAddEmail" type="button" class="btn form_btntbWC">Add Email</button>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-10">
                                <select name="Alias" id="FK_TB_EMAIL_BACKUP_ID" class="form-control" size="5">
                                </select>
                            </div>
                        </div>
