    <!-- Oracle and Apps Section -->
<div class="form-section">
    <div class="section-title">Oracle and Apps</div>
    <!-- Supplier Number -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-SupNumber">Supplier Number:</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="form-SupNumber" placeholder="Supplier Number">
                </div>
            </div>
        </div>
    </div>
    <!-- Supplier Site -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-SupSite">Supplier Site:</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="form-SupSite" placeholder="Supplier Site">
                </div>
            </div>
        </div>
    </div>

    <!-- Payment Method -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-PayMethod">Payment Method:</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="form-PayMethod" placeholder="Payment Method">
                </div>
            </div>
        </div>
    </div>

    <!-- Remit-To Account -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-RemitToAccount">Remit-To Account:</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="form-RemitToAccount" placeholder="Remit-to Account">
                </div>
            </div>
        </div>
    </div>

    <!-- Pay Terms -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                @Html.LabelFor(model => model.FK_TB_ORACLE_PAY_TERMS_ID, "Pay Terms:", htmlAttributes: new { @class = "control-label col-md-2 OracleText" })
                <div class="col-md-10">
                    @Html.DropDownList("FK_TB_ORACLE_PAY_TERMS_ID", null, htmlAttributes: new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.FK_TB_ORACLE_PAY_TERMS_ID, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>

    <!-- Invoice Description -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-InvoiceDescrip">Invoice Description:</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="form-InvoiceDescrip" placeholder="Invoice Description">
                </div>
            </div>
        </div>
    </div>

    <!-- Billing Period -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-BillPeriod">Billing Period:</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="form-BillPeriod" placeholder="Billing Period">
                </div>
            </div>
        </div>
    </div>

    <!-- Distribution Set -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-DistroSet">Distribution Set:</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="form-DistroSet" placeholder="Distribution Set">
                </div>
            </div>
        </div>
    </div>

    <!-- Distribution Combination -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-DistroCombination">Distribution Combination:</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="form-DistroCombination" placeholder="Distribution Combination">
                </div>
            </div>
        </div>
    </div>

    <!-- Accounting Date -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-AccoDate">Accounting Date:</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="form-AccoDate" placeholder="Accounting Date">
                </div>
            </div>
        </div>
    </div>

    <!-- Address -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-Address">Address:</label>
                <div class="col-md-10">
                    <textarea id="form-Address" class="form-control" placeholder="Address" rows="6" cols="50"></textarea>
                </div>
            </div>
        </div>
    </div>
    <!-- Legal Entity -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="FK_TB_LEGAL_ENTITY_ID">Legal Entity:</label>
                <div class="col-md-10">
                    @Html.DropDownList("FK_TB_LEGAL_ENTITY_ID", null, htmlAttributes: new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.FK_TB_LEGAL_ENTITY_ID, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="col-md-6">
                <button class="btn form_btntbWC openModalBtn" data-modal="ShowLegalEntityModal" type="button" id="form-legalEntity">Add a new Legal Entity</button>
            </div>
        </div>
    </div>

    <!-- Add a new legal entity modal-->
    <div id="ShowLegalEntityModal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">Approver</h4>
            </div>

            <div class="modal-body">
                <!-- Legal Entity Section-->
                <div class="form-group">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="control-label col-md-6" for="form-AddLegalEntity">Legal Entity:</label>
                            <div class="col-md-10">
                                <input type="text" class="form-control" id="form-AddLegalEntity" placeholder="Legal Entity" />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <button class="btn form_btntbWC" type="button" id="btn-addLegalEntity">Add a new Legal Entity</button>
                        </div>
                    </div>
                    <br />
                </div>
            </div>
        </div>
    </div>

    <!-- First-Party Taxpayer ID -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-FirstParty">Taxpayer ID:</label>
                <div class="col-md-10">
                    <input type="text" class="form-control" id="form-FirstParty" placeholder="Taxpayer ID">
                </div>
            </div>
        </div>
    </div>
