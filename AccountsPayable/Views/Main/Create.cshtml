    <!-- Approver Section -->
    <div class="form-section">
        <div class="section-title">Approver</div>
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_APPROVER_ID, "Approver:", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_APPROVER_ID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.FK_TB_APPROVER_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-ApproverComents">Aprover Comments:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-ApproverComents" rows="6" cols="120" placeholder="Approver comments"  required></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Invoice Number Format Section -->
    <div class="form-section">
        <div class="section-title">Invoice Number Format</div>
        <!-- Approver info -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-InvoiceF">Invoice Format:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-InvoiceF" placeholder="Invoice Format" required>
                    </div>
                </div>
            </div>
        </div>
        <!-- Type -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-INFType">Type:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-INFType" placeholder="Invoice Type" required>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Cancel and Save Buttons -->
    <button class="btn form_btntbWC btn-cancel" type="button" id="form-cancel">Cancel</button>
    <button class="btn form_btntbWC openModalBtn" data-modal="ShowSaveModal" type="button" id="form-submit">Save</button>

    <!--Save Changes modal-->
    <div id="ShowSaveModal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Save Changes</h4>
                <button type="button" id="cancelButton" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <div class="row">

                        <h4 class="text-center">
                            Would you like to add additional information to the template: <br />
                            Alias / Backup Emails?
                        </h4>
                        <br />
                        <div>
                            <button class="btn form_btntbWC openModalBtn" data-modal="ShowAddAlias_EmailModal" type="button" id="AddAlias_Emailbtn">Yes</button>
                            <button class="btn form_btntbWC" type="button" id="NoAddAlias_Emailbtn">No</button>
                        </div>
                    </div>
                </div>
            </div>
