            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="form-SupplierA">Supplier Agency:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-SupplierA" rows="8" cols="150" required></textarea>
                    </div>
                </div>
            </div>
        </div>
        <!-- Template Comments -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="form-TemplateC">Template Comments:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-TemplateC" rows="8" cols="150" required></textarea>
                    </div>
                </div>
            </div>
        </div>
