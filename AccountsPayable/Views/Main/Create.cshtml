    <!-- Approver Section -->
    <div class="form-section">
        <div class="section-title">Approver</div>
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_APPROVER_ID, "Approver:", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_APPROVER_ID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.FK_TB_APPROVER_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-6">
                    <button class="btn form_btntbWC openModalBtn" data-modal="ShowApproverModal" type="button" id="form-approver">Add a new Approver</button>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-ApproverComents">Aprover Comments:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-ApproverComents" rows="6" cols="120" placeholder="Approver comments"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!--Add a new approver modal-->
        <div id="ShowApproverModal" class="modal" tabindex="-1" role="dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h4 class="modal-title">Approver</h4>
                </div>

                <div class="modal-body">
                    <!-- Approver Section-->
                    <div class="form-group">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="control-label col-md-6" for="form-AddApprover">Approver:</label>
                                <div class="col-md-10">
                                    <input type="text" class="form-control" id="form-AddApprover" placeholder="Approver"/>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <br />
                                <button class="btn form_btntbWC" type="button" id="btn-addAppover">Add a new approver</button>
                            </div>
                        </div>
                        <br />
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Cancel and Save Buttons -->
    <button class="btn form_btntbWC btn-cancel" type="button" id="form-cancel">Cancel</button>
    <button class="btn form_btntbWC openModalBtn" data-modal="ShowSaveModal" type="button" id="form-submit">Save</button>

    <!--Save Changes modal-->
    <div id="ShowSaveModal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Save Changes</h4>
                <button type="button" id="cancelButton" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <div class="row">

                        <h4 class="text-center">
                            Would you like to add additional information to the template: <br />
                            Alias / Backup Emails?
                        </h4>
                        <br />
                        <div style="display: flex; justify-content: center; gap: 10vw;">
                            <button class="btn form_btntbWC openModalBtn" data-modal="ShowAddAlias_EmailModal" type="button" id="AddAlias_Emailbtn">Yes</button>
                            <button class="btn form_btntbWC" type="button" id="NoAddAlias_Emailbtn">No</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Add alias / Backup emails modal-->
    <div id="ShowAddAlias_EmailModal" class="modal" tabindex="-1" role="dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Alias and Backup email's information</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!--Alias section-->
                <div class="form-group">
                    <div class=" row">
                        <div class="col-md-6">
                            <label class="control-label col-md-6" for="form-AddAlias">Alias:</label>
                            <div class="col-md-10">
                                <input type="text" class="form-control" id="form-AddAlias" placeholder="Alias name">

                            </div>
                        </div>
                        <div class="col-md-4">
                            <br />
                            <button class="btn form_btntbWC" type="button" id="btn-addAlias">Add Alias</button>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-10">
                                <select name="Alias" id="FK_TB_TEMPLATE_ALIAS_ID" class="form-control" size="5">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <br />

                <!--Email section-->
                <div class="form-group">
                    <div class=" row">
                        <div class="col-md-6">
                            <label class="control-label col-md-8" for="form-BackUpEmail">Back Up Emails:</label>
                            <div class="col-md-10">
                                <textarea class="form-control" id="form-BackUpEmail" placeholder="Backup email" rows="5" cols="100"></textarea>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <br />
                            <button id="ButtonAddEmail" type="button" class="btn form_btntbWC">Add Email</button>
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-10">
                                <select name="Alias" id="FK_TB_EMAIL_BACKUP_ID" class="form-control" size="5">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div>
                <button class="btn form_btntbWC" type="button" id="cancelButton">Cancel</button>
                <button class="btn form_btntbWC" type="button" id="btn_AddAlias_Email">Save</button>
            </div>
        </div>
