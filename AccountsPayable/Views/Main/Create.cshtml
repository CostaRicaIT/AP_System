                    @Html.DropDownList("FK_TB_ORACLE_TYPE_ID", null, htmlAttributes: new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.FK_TB_ORACLE_TYPE_ID, "", new { @class = "text-danger" })
                </div>
            </div>
        </div>
    </div>
    <!-- Description -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2 OracleText" for="form-Description">Description:</label>
                <div class="col-md-10">
                    <textarea id="form-Description" class="form-control" placeholder="Description" rows="6" cols="50"></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- Oracle Notes -->
    <div class="form-group">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label col-md-2" for="form-OracleN">Oracle Notes:</label>
                <div class="col-md-10">
                    <textarea class="form-control" id="form-OracleN" rows="6" cols="50" placeholder="Oracle Notes"></textarea>
                </div>
            </div>
            <!-- Oracle Instructions -->
            <div class="col-md-6">
                <label class="control-label col-md-2 checkbox-label" for="form-OracleI" id="Label-Oracle">Oracle Instructions:</label>
                <div class="col-md-10">
                    <textarea class="form-control" id="form-OracleI" rows="6" cols="50" placeholder="Oracle instructions"></textarea>
                </div>
            </div>
        </div>
    </div>
</div>
