                <div class="col-md-8">
                    <label class="control-label col-md-2" for="form-TemplateC">Template Comments:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-TemplateC" rows="8" cols="150"></textarea>
                    </div>
                </div>
            </div>
        </div>
