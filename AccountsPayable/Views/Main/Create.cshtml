@model AccountsPayable.Models.TB_TEMPLATE

@{
    ViewBag.Title = "AP Templates | Create";
}

<h2> </h2>
<br />
<link href="~/Content/Style.css" rel="stylesheet" />
<link href="~/Content/TemplateModal.css" rel="stylesheet" />

<form id="form">

    <!-- Supplier Information Section -->
    <div class="form-section">
        <div class="section-title">Supplier Information</div>

        <!-- Folder -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-Folder" class="control-label col-md-2">Folder:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-Folder" placeholder="Select folder">
                    </div>
                </div>
            </div>
        </div>

        <!-- Tax ID -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="form-TaxID" class="control-label col-md-2">Tax Id:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-TaxID" placeholder="Tax ID">
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="control-label col-md-6" for="BoxNoTaxId">No Tax Id information</label>
                    <input type="checkbox" id="BoxNoTaxId" name="NoTaxId" />
                </div>

            </div>
        </div>

        <!-- Supplier Name -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-SupName">Supplier Name:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-SupName" placeholder="Supplier Name">
                    </div>
                </div>
                <div class="col-md-6">
                    <label for="BoxSupName" class="control-label col-md-6">There is no Supplier Name</label>
                    <input type="checkbox" id="BoxSupName" value="1">
                </div>
            </div>
        </div>

        <!-- Remit To -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-RemitTo">Remit to:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-RemitTo" placeholder="Remit to">
                    </div>
                </div>
                <div class="col-md-6">
                    <label for="BoxNoRemitInfo" class="control-label col-md-6">There is no Remit information</label>
                    <input type="checkbox" id="BoxNoRemitInfo" value="1">
                </div>
            </div>
        </div>

        <!-- Historic Remit To -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-HistRemitTo">Historic Remit To:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-HistRemitTo" rows="6" cols="50"></textarea>
                        <br />
                    </div>
                </div>

                @*<div class="col-md-4">
                        <button id="ButtonAddHistoricRemit" type="button" class="styled-button align-right btn-submit" disabled>Add Historic Remit to</button>
                        <button id="ButtonViewHisticRemit" type="button" class="styled-button align-right openModalBtn" data-modal="ShowHistoricRemitModal" disabled>View Historic Remit to</button>
                    </div>*@
            </div>
            <!--Modal to see historic remit -->
            @* <div id="ShowHistoricRemitModal" class="modal">
                    <div class="modal-content">
                        <span class="close">&times;</span>
                        <div class="row">
                            <div class="control-label col-md-12">
                                <label class="control-label col-md-4" for="historicRemitInfoView">Historic Remit to:</label>
                                <div class="col-md-10">
                                    <textarea class="form-control" id="historicRemitInfoView" readonly rows="6" cols="75" placeholder="..."></textarea>
                                    <br />
                                </div>
                            </div>
                        </div>
                        <!--Select Historic Remit to -->
                        <div class="row">
                            <div class="col-md-12">
                                <div class="col-md-6">
                                    @Html.DropDownList("FK_TB_TEMPLATE_HISTORIC_REMIT_ID", null, htmlAttributes: new { @size = "5" })
                                </div>
                            </div>
                        </div>
                    </div>
                </div>*@

            <!-- Our Vendor # / Account # -->
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label class="control-label col-md-2" for="form-OurVendorA" id="label-OurVendorA">OUR VENDOR #/ ACCOUNT #:</label>
                        <div class="col-md-10">
                            <textarea class="form-control" id="form-OurVendorA" rows="6" cols="50"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Source -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_ORACLE_SOURCE_ID, "Source:", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_ORACLE_SOURCE_ID", null, htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.FK_TB_ORACLE_SOURCE_ID, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

    </div>
    <br />

    <!-- Invoice Number Format Section -->
    <div class="form-section">
        <div class="section-title">Invoice Number Format</div>
        <!-- Approver info -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-InvoiceF">Invoice Format:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-InvoiceF" placeholder="Invoice Format">
                    </div>
                </div>
            </div>
        </div>
        <!-- Type -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-INFType">Type:</label>
                    <div class="col-md-10">
                        <input type="text" class="form-control" id="form-INFType" placeholder="Invoice Type">
                    </div>
                </div>
            </div>
        </div>

        <!-- Invoice Notes -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-InvoiceNotes" id="label-InvoiceNotes">Invoice Notes:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-InvoiceNotes" rows="6" cols="50"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Forms Section -->
    <div class="form-section">
        <div class="section-title">Forms</div>
        <!-- W9/W-8BEN Form -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-W9W8" id="label-W9/W-8BEN">W9/W-8BEN Form:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-W9W8" rows="6" cols="50"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- VSU Form -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-VSU" id="label-VSU">VSU Form:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-VSU" rows="6" cols="50"></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Alias Section -->
    @*<div class="form-section">
            <div class="section-title">Alias</div>
            Alias Input and Button
            <div class="form-group">
