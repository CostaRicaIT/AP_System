

@{
    ViewBag.Title = "Template";
}

<h2>ID Template</h2>
<br>
<link href="~/Content/Style.css" rel="stylesheet" />
<link href="~/Content/TemplateModal.css" rel="stylesheet" />

<div id="form-container">
    <form id="form-crud">

        <!-- Supplier Information Section -->
        <div class="form-section">
            <div class="section-title">Supplier Information</div>
            <!-- Tax ID -->
            <div class="form-row">
                <label for="form-TaxID">Tax Id:</label>
                <div class="TaxId-checkbox-wrapper">
                    <input type="text" class="form-control" id="form-TaxID" placeholder="12-34567">
                    <label for="BoxNoTaxId" class="checkbox-label">
                        <span>No Tax Id information</span>
                        <input type="checkbox" id="BoxNoTaxId" name="NoTaxId">
                    </label>
                </div>
            </div>
            <!-- Remit To -->
            <div class="form-row">
                <label for="form-RemitTo">Remit to:</label>
                <div class="RemitTo-checkbox-wrapper">
                    <input type="text" class="form-control" id="form-RemitTo" placeholder="Address here ...">
                    <label for="BoxNoRemitInfo" class="checkbox-label">
                        <span>There is no Remit information</span>
                        <input type="checkbox" id="BoxNoRemitInfo" value="1">
                    </label>
                </div>
            </div>
            <!-- Supplier Name -->
            <div class="form-row">
                <label for="form-SupName">Supplier Name:</label>
                <div class="SupplierName-checkbox-wrapper">
                    <input type="text" class="form-control" id="form-SupName" placeholder="Supplier Name here ...">
                    <label for="BoxSupName" class="checkbox-label">
                        <span>There is no Supplier Name</span>
                        <input type="checkbox" id="BoxSupName" value="1">
                    </label>
                </div>
            </div>
            <!-- Historic Remit To -->
            <div class="form-row">
                <label for="form-HistRemitTo">Historic Remit To:</label>
                <div class="HistRemitTo-checkbox-wrapper">
                    <textarea id="form-HistRemitTo" class="General-textarea" rows="6" cols="100"></textarea>
                </div>
                <div class="button-wrapper">
                    <button id="ButtonAddHistoricRemit" type="button" class="styled-button align-right btn-submit">Add Historic Remit to</button>
                    <button id="ButtonViewHisticRemit"  type="button" class="styled-button align-right openModalBtn" data-modal="ShowHistoricRemitModal">View Historic Remit to</button>
                </div>
                <!--Modal to add historic remit-->

                @*<div id="AddHistoricRemitModal" class="modal">
                    <div class="modal-content">
                        <span class="close">&times;</span>
                        <label for="historicRemitDate">Date</label><br>
                        <input type="date" id="historicRemitDate" />
                        <p><label for="historicRemitInfoAdd">Historic Remit To:</label></p>
                        <textarea id="historicRemitInfoAdd" class="General-textarea" rows="6" cols="100"></textarea>
                        <div>
                            <button class="btn form_btntbWC" type="button" id="cancelHistoricRemit">Cancel</button>
                            <button class="btn form_btntbWC btn-submit" id="btn-submit">Save</button>
                        </div>
                    </div>
                </div>*@

                <!--Modal to see historic remit-->
                <div id="ShowHistoricRemitModal" class="modal">
                    <div class="modal-content">
                        <span class="close">&times;</span>
                        <p><label for="historicRemitInfoView">Historic Remit to:</label></p>
                        <textarea id="historicRemitInfoView" rows="6" cols="60" placeholder="..."></textarea>
                        <br />
                        <!-- Select Historic Remit to -->
                        <div class="form-row">
                            <select id="form-SelectAlias" size="4">
                            
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Our Vendor # / Account # -->
            <div class="form-row">
                <label id="label-OurVendorA">OUR VENDOR # <br>/ ACCOUNT #:</label>
                <div class="HistRemitTo-checkbox-wrapper">
                    <textarea id="form-OurVendorA" rows="6" cols="100"></textarea>
                </div>
            </div>
        </div>
        <br />

        <!-- Alias Section -->
        <div class="form-section">
            <div class="section-title">Alias</div>
            <!-- Alias Input and Button -->
            <div class="form-row">
                <label for="form-AddAlias">Alias:</label>
                <div class="AddAlias-button-wrapper">
                    <input type="text" class="form-control" id="form-Alias" placeholder="Alias name here...">
                    <button id="ButtonAddAlias" type="button" class="styled-button align-right openModalBtn" data-modal="AddAliasModal">Add alias</button>
                </div>
                <!-- Select Alias Dropdown -->
            </div>
            <div class="form-row">
                <select id="form-SelectInfoAlias" class="extended-select" size="4">
                </select>
            </div>
            <!--Add Alias modal-->
            <div id="AddAliasModal" class="modal">
                <div class="modal-content">
                    <span class="close">&times;</span>
                    <p><label for="alias">Alias:</label></p>
                    <input type="text" id="form-AddAlias" />
                    <div>
                        <br />
                        <button class="btn form_btntbWC" type="button" id="cancelAlias">Cancel</button>
                        <button class="btn form_btntbWC btn-submitAlias" type="button" id="btn-submitAlias">Save</button>
                    </div>
                </div>
            </div>
        </div>
        <br />
        <!-- Oracle and Apps Section -->
        <div class="form-section">
            <div class="section-title">Oracle and Apps</div>
            <!-- Supplier Site -->
            <div class="form-row">
                <label for="form-SupSite">Supplier Site:</label>
                <div class="General General-Width">
                    <input type="text" class="form-control" id="form-SupSite" placeholder="Text here ...">
                </div>
            </div>
            <!-- Address -->
            <div class="form-row">
                <label for="form-Address">Address:</label>
                <div class="General">
                    <textarea id="form-Address" class="Address-textarea" placeholder="PO BOX 123456 Street AV 123 State here..."></textarea>
                </div>
            </div>
            <!-- Legal Entity -->
            <div class="form-row">
                <label for="form-LegalE">Legal Entity:</label>
                <div class="General">
                    <select id="form-LegalE" class="extended-select">
                        <option>Aya Healthcare, Inc</option>
                        <!-- Add more options here if needed -->
                    </select>
                </div>
            </div>
            <!-- First-Party Taxpayer ID -->
            <div class="form-row">
                <label for="form-FirstParty">First-Party Taxpayer ID:</label>
                <div class="General">
                    <input type="text" class="form-control" id="form-FirstParty" placeholder="123 ...">
                </div>
            </div>
            <!-- Type -->
            <div class="form-row">
                <label for="form-Type">Type:</label>
                <div class="General">
                    <select id="form-Type" class="extended-select">
                        <option>Standard</option>
                        <!-- Add more options here if needed -->
                    </select>
                </div>
            </div>
            <!-- Description -->
            <div class="form-row">
                <label for="form-Description">Description:</label>
                <div class="General">
                    <textarea id="form-Description" class="Description-textarea" placeholder="Description here..."></textarea>
                </div>
            </div>
            <!-- Pay Terms -->
            <div class="form-row">
                <label for="form-PayTerms">Pay Terms:</label>
                <div class="General">
                    <select id="form-PayTerms" class="extended-select">
                        <option>Net 30</option>
                        <!-- Add more options here if needed -->
                    </select>
                </div>
            </div>
            <!-- Account Coding -->
            <div class="form-row">
                <label for="form-AccountC">Account Coding:</label>
                <div class="General">
                    <input type="text" class="form-control" id="form-AccountC" placeholder="123 ...">
                </div>
            </div>
            <!-- Source -->
            <div class="form-row">
                <label for="form-Source">Source:</label>
                <div class="General">
                    <select id="form-Source" class="extended-select">
                        <option>Queue</option>
                        <!-- Add more options here if needed -->
                    </select>
                    <label id="Label-Oracle" class="checkbox-label">
                        <span>Oracle Instructions:</span>
                    </label>
                </div>
            </div>
            <!-- Oracle Notes -->
            <div class="form-row">
                <label for="form-OracleN">Oracle Notes:</label>
                <div class="General">
                    <textarea id="form-OracleN" class="OracleN-textarea" placeholder="Oracle Notes here..."></textarea>
                </div>
                <!-- Additional Oracle Notes -->
                <textarea id="form-OracleI" class="OracleI-textarea" placeholder="Oracle Notes here..."></textarea>
            </div>
        </div>
        <br />

        <!-- Notes & Instructions Section -->
        <div class="form-section">
            <div class="section-title">Notes & Instructions</div>
            <!-- Highlights -->
            <div class="form-row">
                <label for="form-Higlights">Highlights</label>
                <div class="General-checkbox-wrapper">
                    <textarea id="form-Higlights"  rows="7" cols="107"></textarea>
                    <div class="button-wrapper">
                        <button id="ButtonAddHistory" type="button" class="styled-button align-right openModalBtn" data-modal="AddAHighlights">Add History</button>
                        <button id="ButtonViewHistory" type="button" class="styled-button align-right openModalBtn" data-modal="ShowHighlights">View History</button>
                    </div>
                </div>
            </div>
            <!-- Highlights Comments -->
            <div class="form-row">
                <label for="form-HiglightsC">Highlights Comments:</label>
                <div class="General-checkbox-wrapper">
                    <textarea id="form-HiglightsC"  rows="7" cols="107"></textarea>
                </div>
            </div>
            <!-- Instructions -->
            <div class="form-row">
                <label for="form-Instructions">Instructions:</label>
                <div class="General-checkbox-wrapper">
                    <textarea id="form-Instructions"  rows="7" cols="107"></textarea>
                </div>
            </div>
            <!-- Exceptions -->
            <div class="form-row">
                <label for="form-Exceptions">Exceptions:</label>
                <div class="General-checkbox-wrapper">
                    <textarea id="form-Exceptions"  rows="7" cols="107"></textarea>
                </div>
            </div>
            <!-- Most Common Issues -->
            <div class="form-row">
                <label for="form-MostCI">Most Common <br> Issues:</label>
                <div class="General-checkbox-wrapper">
                    <textarea id="form-MostCI"  rows="7" cols="115"></textarea>
                </div>
            </div>
            <!-- Supplier Agency -->
            <div class="form-row">
                <label for="form-SupplierA">Supplier Agency:</label>
                <div class="General-checkbox-wrapper">
                    <textarea id="form-SupplierA"  rows="7" cols="107"></textarea>
                </div>
            </div>
            <!-- Template Comments -->
            <div class="form-row">
                <label for="form-TemplateC">Template Comments:</label>
                <div class="General-checkbox-wrapper">
                    <textarea id="form-TemplateC"  rows="7" cols="107"></textarea>
                </div>
            </div>
        </div>
        <!--Add Highlights modal-->
        <div id="AddAHighlights" class="modal">
            <div class="modal-content">
                <span class="close">&times;</span>
                <label for="historicRemitDate">Date</label><br>
                <input type="date" id="historicRemitDate" />
                <!-- Highlights -->

                <p><label for="HighlightsHistoryAdd">Highlights</label></p>
                <textarea id="HighlightsHistoryAdd" rows="4" cols="80"></textarea>

                <!-- Highlights Comments -->
                <p><label for="HighlightsCHistoryAdd">Highlights Comments:</label></p>
                <textarea id="HighlightsCHistoryAdd" rows="4" cols="80"></textarea>

                <!-- Instructions -->
                <p><label for="InstructionsHistoryAdd">Instructions:</label></p>
                <textarea id="InstructionsHistoryAdd" rows="4" cols="80"></textarea>

                <!-- Exceptions -->
                <p><label for="ExceptionsHistoryAdd">Exceptions:</label></p>
                <textarea id="ExceptionsHistoryAdd" rows="4" cols="80"></textarea>

                <!-- Most Common Issues -->
                <p><label for="MostCIHistoryAdd">Most Common Issues:</label></p>
                <textarea id="MostCIHistoryAdd" rows="4" cols="80"></textarea>

                <!-- Supplier Agency -->
                <p><label for="SupplierAHistoryAdd">Supplier Agency:</label></p>
                <textarea id="SupplierAHistoryAdd" rows="4" cols="80"></textarea>

                <!-- Template Comments -->
                <p><label for="TemplateCHistoryAdd">Template Comments:</label></p>
                <textarea id="TemplateComments" rows="4" cols="80"></textarea>
                <div>
                    <button class="btn form_btntbWC" type="button" id="cancelHiglihts">Cancel</button>
                    <button class="btn form_btntbWC" type="button" id="submitHiglihts">Save</button>
                </div>
            </div>
        </div>

        <!--Show Highlights modal-->
        <div id="ShowHighlights" class="modal">
            <div class="modal-content">
                <span class="close">&times;</span>
                <!-- Highlights -->

                <p><label for="HighlightsHistoryView">Highlights</label></p>
                <textarea id="HighlightsHistoryView" rows="4" cols="80"></textarea>

                <!-- Highlights Comments -->
                <p><label for="HighlightsCHistoryView">Highlights Comments:</label></p>
                <textarea id="HighlightsCHistoryView" rows="4" cols="80"></textarea>

                <!-- Instructions -->
                <p><label for="InstructionsHistoryView">Instructions:</label></p>
                <textarea id="InstructionsHistoryView" rows="4" cols="80"></textarea>

                <!-- Exceptions -->
                <p><label for="ExceptionsHistoryView">Exceptions:</label></p>
                <textarea id="ExceptionsHistoryView" rows="4" cols="80"></textarea>

                <!-- Most Common Issues -->
                <p><label for="MostCIHistoryView">Most Common Issues:</label></p>
                <textarea id="MostCIHistoryView" rows="4" cols="80"></textarea>

                <!-- Supplier Agency -->
                <p><label for="SupplierAHistoryView">Supplier Agency:</label></p>
                <textarea id="SupplierAHistoryView" rows="4" cols="80"></textarea>

                <!-- Template Comments -->
                <p><label for="TemplateCHistoryView">Template Comments:</label></p>
                <textarea id="TemplateCHistoryView" rows="4" cols="80"></textarea>
            </div>
        </div>

        <br />

        <!-- Emails Section -->
        <div class="form-section">
            <div class="section-title">Emails</div>
            <!-- Back-Up Emails -->
            <div class="form-row">
                <label for="form-BackUpEmails">Back Up Emails:</label>
                <div class="General-checkbox-wrapper">
                    <textarea id="form-BackUpEmails"  rows="6" cols="112" placeholder="Backup email here..."></textarea>
                    
                    <div class="button-wrapper">
                        <button id="ButtonAddEmail" type="button" class="styled-button align-right openModalBtn" data-modal="AddEmailModal">Add Email</button>
                    </div>
                </div>
            </div>
            <div id="AddEmailModal" class="modal">
                <div class="modal-content">
                    <span class="close">&times;</span>
                    <label for="emaildate">Date</label><br>
                    <input type="date" id="emaildate" />
                    <p><label for="emailinfo">Email:</label></p>
                    <textarea id="emailinfo" class="General-textarea" rows="6" cols="100"></textarea>
                    <div>
                        <button class="btn form_btntbWC" type="button" id="cancelEmail">Cancel</button>
                        <button class="btn form_btntbWC" type="button" id="submitEmail">Save</button>
                    </div>
                </div>
            </div>
            <!-- Select Mails Dropdown -->
            <div class="form-row">
                <select id="form-SelectMails" class="extended-select" size="4">
                    <option>8/22/2023 - Email</option>
                    <option>7/22/2023 - Email</option>
                    <option>5/22/2019 - Email</option>
                    <!-- Add more options here if needed -->
                </select>
            </div>
        </div>
        <br />

        <!-- Approver Section -->
        <div class="form-section">
            <div class="section-title">Approver</div>
            <div class="form-row">
                <label for="form-Approver-info">Approver info:</label>
                <div class="General">
                    <select id="form-Approver-info" class="extended-select">
                        <option>Approver</option>
                        <!-- Add more options here if needed -->
                    </select>
                </div>
            </div>
            <div class="form-row">
                <label for="form-ApproverComents">Aprover Comments:</label>
                <div class="General-checkbox-wrapper">
                    <textarea id="form-ApproverComents"  rows="6" cols="120" placeholder="Backup email here..."></textarea>
                </div>
            </div>
        </div>
        <br />

        <!-- Invoice Number Format Section -->
        <div class="form-section">
            <div class="section-title">Invoice Number Format</div>
            <!-- Approver info -->
            <div class="form-row">
                <label for="form-InvoiceF">Invoice Format:</label>
                <div class="General General-Width">
                    <input type="text" class="form-control" id="form-InvoiceF" placeholder="Nomenclature">
                </div>
            </div>
            <!-- Type -->
            <div class="form-row">
                <label for="form-INFType">Type:</label>
                <div class="General General-Width">
                    <input type="text" class="form-control" id="form-INFType" placeholder="Actual invoice / Statement invoice / Itemize Doc">
                </div>
            </div>
        </div>
        <br />

        <!-- Cancel and Save Buttons -->
        <button class="btn form_btntbWC" type="button" id="form-cancel">Cancel</button>
        <button class="btn form_btntbWC" type="button" id="form-submit">Save</button>

    </form>
</div>
@section scripts {

    <script src="~/Scripts/CRUDHistoric.js"></script>
    <script src="~/Scripts/templateModal.js"></script>
    <script src="//code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="//code.jquery.com/ui/1.13.1/jquery-ui.min.js"></script>



}