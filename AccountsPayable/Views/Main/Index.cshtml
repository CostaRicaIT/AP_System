@model IEnumerable<AccountsPayable.Models.TB_TEMPLATE>
@using AccountsPayable.Models

@{
    ViewBag.Title = "AP Templates | Dashboard";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />
<link rel="stylesheet" href="~/Content/table.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/staterestore/1.3.0/css/stateRestore.dataTables.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<div class="container">
    <p>
        <button class="btn-primary" type="submit">@Html.ActionLink("Create New", "Create")</button>
        @*@Html.ActionLink("Create New", "Create")*@
    </p>

    <table id="dataTable" class="table cell-border stripe display" width="100%">
        <thead>
            <tr>
                <th>ID</th>
                <th>Alias</th>
                <th>Folder</th>
                <th>Tax ID</th>
                <th>Supplier Name</th>
                <th>Supplier Number</th>
                <th>Remit To</th>
                <th>Supplier Site</th>
                <th>Histoic Remit to</th>
                <th>Vendor Account</th>
                <th>Source</th>
                <th>Invoice Format</th>
                <th>Invoice Type</th>
                <th>Invoice Notes</th>
                <th>W9/W-8BEN Form</th>
                <th>VSU Form</th>
                <th>Payment Method</th>
                <th>Remit-To Account</th>
                <th>Pay Terms</th>
                <th>Invoice Description</th>
                <th>Billing Period</th>
                <th>Dates</th>
                <th>Distribution Set</th>
                <th>Distribution Combination</th>
                <th>Accounting Date</th>
                <th>Legal Entity</th>
                <th>Tax Payer ID</th>
                <th>Type</th>
                <th>Description</th>
                <th>Oracle Notes</th>
                <th>Oracle Instructions</th>
                <th>AR Key Contacts/Currents</th>
                <th>AR Key Contacts/Prior</th>
                <th>Approver</th>
                <th>Approver Comments</th>
                <th>Email Backup</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.TEMP_ID</td>
                    <td class="alias">@item.ALIAS_NAME</td>
                    <td>@item.TEMP_FOLDER</td>
                    <td class="tax">@item.TEMP_TAX_ID</td>
                    <td>@item.TEMP_SUPPLIER_NAME</td>
                    <td>@item.TEMP_SUPPLIER_NUMBER</td>
                    <td>@item.TEMP_REMIT_TO</td>
                    <td>@item.TEMP_SUPPLIER_SITE</td>
                    <td>@Html.Raw(item.HISTORIC_REMIT)</td>
                    <td>@item.TEMP_VENDOR_ACCOUNT</td>
                    <td>@item.TB_ORACLE_SOURCE.ORACLE_SOURCE_DESCRIPTION</td>
                    <td>@item.TEMP_INVOICE_FORMAT</td>
                    <td>@item.TEMP_INVOICE_TYPE</td>
                    <td>@Html.Raw(item.TEMP_INVOICE_NOTES)</td>
                    <td>@Html.Raw(item.TEMP_W9_W8)</td>
                    <td>@Html.Raw(item.TEMP_VSU)</td>
                    <td>@item.TEMP_PAYMENT_METHOD</td>
                    <td>@item.TEMP_REMIT_TOACCOUNT</td>
                    <td>@item.TB_ORACLE_PAY_TERMS.PAY_TERMS_DESCRIPTION</td>
                    <td>@item.TEMP_INVOICE_DESCRIPTION</td>
                    <td>@Html.Raw(item.TEMP_BILLING_PERIOD)</td>
                    <td>@item.TEMP_BILLING_PRERIOD_DATE</td>
                    <td>@item.TEMP_DISTRIBUTION_SET</td>
                    <td>@item.TEMP_DISTRIBUTION_COMBINATION</td>
                    <td>@item.TEMP_ACCOUNTING_DATE</td>
                    <td>@item.TB_ORACLE_LEGAL_ENTITIES.LEGAL_ENTITY_NAME</td>
                    <td>@item.TEMP_TAXPAYER_ID</td>
                    <td>@item.TB_ORACLE_TYPE.ORACLE_TYPE_NAME</td>
                    <td>@Html.Raw(item.TEMP_ORACLE_DESCRIPTION)</td>
                    <td>@Html.Raw(item.TEMP_ORACLE_NOTES)</td>
                    <td>@Html.Raw(item.TEMP_ORACLE_INSTRUCTIONS)</td>
                    <td>@item.CONTACTS_CURRENT</td>
                    <td>@item.CONTACTS_PRIOR</td>
                    <td>@item.TB_APPROVER.APPROVER_NAME</td>
                    <td>@item.TEMP_APPROVER_COMMENTS</td>
                    <td>@item.EMAIL_BACKUP</td>
                    <td>
                        <div class="button-container">


                            @if (Session["Permission"] != null && ((TB_VIEW_PERMISSIONS)Session["Permission"]).FK_TB_LOGIN_ROLE_ID == 3)
                            {
                                <button class="dt-button filterButton view-button" data-id="@item.TEMP_ID"><i class="fa-solid fa-eye"></i></button>
                            }

                            else
                            {
                                <button class="dt-button filterButton view-button" data-id="@item.TEMP_ID"><i class="fa-solid fa-eye"></i></button>
                                <button class="dt-button filterButton edit-button" data-id="@item.TEMP_ID"><i class="fas fa-edit"></i></button>
                                <button class="dt-button filterButton erase-button" data-id="@item.TEMP_ID"><i class="fa-solid fa-eraser"></i></button>
                            }

                        </div>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Button to open the modal -->
<!-- Modal -->
<div class="modal" id="filtersModal" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="columnModalLabel">Column Visibility</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Add your icons and checkboxes here -->
                <button id="showColumnsButton" class="btn btn-link">
                    <i class="fa fa-eye"></i> Show Columns
                </button><br />
                @*<button id="saveColumnsButton" class="btn btn-link">
                        <i class="fa fa-save"></i> Save Columns
                    </button><br />*@
                <button id="resetColumnsButton" class="btn btn-link">
                    <i class="fa fa-undo"></i> Reset Columns
                </button><br />

                <!-- Add checkboxes for all columns -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
