@model IEnumerable<AccountsPayable.Models.TB_TEMPLATE>

@{
    ViewBag.Title = "AP Templates | Dashboard";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />
<link rel="stylesheet" href="~/Content/table.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/staterestore/1.3.0/css/stateRestore.dataTables.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<div class="container">
    <p>
        <button class="btn-primary" type="submit">@Html.ActionLink("Create New", "Create")</button>
        @*@Html.ActionLink("Create New", "Create")*@
    </p>

    <table id="dataTable" class="table cell-border stripe display" width="100%">
        <thead>
            <tr>
                <th>ID</th>
                <th>Alias</th>
                <th>Tax ID</th>
                <th>Remit To</th>
                <th>Supplier Name</th>
                <th>Supplier Number</th>
                <th>Vendor Account</th>
                <th>Supplier Site</th>
                <th>Address</th>
                <th>Legal Entity</th>
                <th>Tax Payer ID</th>
                <th>Type</th>
                <th>Description</th>
                <th>Pay Terms</th>
                <th>Account coding</th>
                <th>Source</th>
                <th>Oracle Notes</th>
                <th>Oracle Instructions</th>
                <th>Approver</th>
                <th>Approver Comments</th>
                <th>Invoice Format</th>
                <th>Invoice Type</th>
                <th>Email Backup</th>
                <th>Action</th>
            </tr>
        </thead>
        @*<tfoot>
                <tr>
                    <th>ID</th>
                    <th>Alias</th>
                    <th>Tax ID</th>
                    <th>Remit To</th>
                    <th>Supplier Name</th>
                    <th>Supplier Number</th>
                    <th>Vendor Account</th>
                    <th>Supplier Site</th>
                    <th>Address</th>
                    <th>Legal Entity</th>
                    <th>Tax Payer ID</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Pay Terms</th>
                    <th>Account coding</th>
                    <th>Source</th>
                    <th>Oracle Notes</th>
                    <th>Oracle Instructions</th>
                    <th>Approver</th>
                    <th>Approver Comments</th>
                    <th>Invoice Format</th>
                    <th>Invoice Type</th>
                    <th>Email Backup</th>
                    <th></th>
                </tr>
            </tfoot>*@
        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.TEMP_ID</td>
                    <td>@item.ALIAS_NAME</td>
                    <td>@item.TEMP_TAX_ID</td>
                    <td>@item.TEMP_REMIT_TO</td>
                    <td>@item.TEMP_SUPPLIER_NAME</td>
                    <td>@item.TEMP_SUPPLIER_NUMBER</td>
                    <td>@item.TEMP_VENDOR_ACCOUNT</td>
                    <td>@item.TEMP_SUPPLIER_SITE</td>
                    <td>@item.TEMP_ADDRESS</td>
                    <td>@item.TB_ORACLE_LEGAL_ENTITIES.LEGAL_ENTITY_NAME</td>
                    <td>@item.TEMP_TAXPAYER_ID</td>
                    <td>@item.TB_ORACLE_TYPE.ORACLE_TYPE_NAME</td>
                    <td>@item.TEMP_ORACLE_DESCRIPTION</td>
                    <td>@item.TB_ORACLE_PAY_TERMS.PAY_TERMS_DESCRIPTION</td>
                    <td>@item.TEMP_ACCOUNT_CODING</td>
                    <td>@item.TB_ORACLE_SOURCE.ORACLE_SOURCE_DESCRIPTION</td>
                    <td>@item.TEMP_ORACLE_NOTES</td>
                    <td>@item.TEMP_ORACLE_INSTRUCTIONS</td>
                    <td>@item.TB_APPROVER.APPROVER_NAME</td>
                    <td>@item.TEMP_APPROVER_COMMENTS</td>
                    <td>@item.TEMP_INVOICE_FORMAT</td>
                    <td>@item.TEMP_INVOICE_TYPE</td>
                    <td>@item.EMAIL_BACKUP</td>
                    <td></td>

                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Button to open the modal -->
<!-- Modal -->
<div class="modal" id="filtersModal" tabindex="-1" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="columnModalLabel">Column Visibility</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Add your icons and checkboxes here -->
                <button id="showColumnsButton" class="btn btn-link">
                    <i class="fa fa-eye"></i> Show Columns
                </button><br />
                @*<button id="saveColumnsButton" class="btn btn-link">
                        <i class="fa fa-save"></i> Save Columns
                    </button><br />*@
                <button id="resetColumnsButton" class="btn btn-link">
                    <i class="fa fa-undo"></i> Reset Columns
                </button><br />

                <!-- Add checkboxes for all columns -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- toggle Columns Modal -->
<div class="modal" id="toggleColumnsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                @*<label>
                    <input type="checkbox" class="toggle-column" data-column="0"> ID
                </label><br>*@

                <label>
                    <input type="checkbox" class="toggle-column" data-column="1"> Alias
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="2"> Tax ID
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="3"> Remit To
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="4"> Supplier Name
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="5"> Supplier Number
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="6"> Vendor account
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="7"> Supplier Site
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="8"> Address
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="9"> Legal Entity
                </label><br>


                <label>
                    <input type="checkbox" class="toggle-column" data-column="10"> Tax Payer ID
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="11"> Type
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="12"> Description
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="13"> Pay Terms
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="14"> Account Coding
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="15"> Source
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="16"> Oracle Notes
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="17"> Oracle Instructions
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="18"> Approver
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="19"> Approver Coments
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="20"> Invoice Format
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="21"> Invoice Type
                </label><br>

                <label>
                    <input type="checkbox" class="toggle-column" data-column="22"> Email backup
                </label><br>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveColumnVisibility">Ok</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/staterestore/1.3.0/js/dataTables.stateRestore.min.js"></script>

    <script src="~/Scripts/dashboard.js"></script>
}