@model AccountsPayable.Models.TB_TEMPLATE

@{
    ViewBag.Title = "Details";
}
<link href="~/Content/Style.css" rel="stylesheet" />
<link href="~/Content/TemplateModal.css" rel="stylesheet" />

<h2>View</h2>
<label hidden id="templateId">@Model.TEMP_ID</label>
<br />

@using (Html.BeginForm())
{


    <!-- Supplier Information Section -->
    <div class="form-section">
        <div class="section-title">Supplier Information</div>
        <!-- Tax ID -->
        <div class="form-group">
            <div class=" row">
                <div class="col-md-6">
                    <label for="TEMP_TAX_ID" class="control-label col-md-2">Tax Id:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.TEMP_TAX_ID, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                    </div>
                </div>
                @*<div class="col-md-6">
                        <label class="control-label col-md-6" for="BoxNoTaxId">No Tax Id information</label>
                        <input type="checkbox" id="BoxNoTaxId" name="NoTaxId" />
                    </div>*@

            </div>
        </div>

        <!-- Remit To -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_REMIT_TO">Remit to:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.TEMP_REMIT_TO, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                    </div>
                </div>
                @*<div class="col-md-6">
                        <label for="BoxNoRemitInfo" class="control-label col-md-6">There is no Remit information</label>
                        <input type="checkbox" id="BoxNoRemitInfo" value="1">
                    </div>*@
            </div>
        </div>

        <!-- Supplier Name -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_SUPPLIER_NAME">Supplier Name:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.TEMP_SUPPLIER_NAME, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                    </div>
                </div>
                @*<div class="col-md-6">
                        <label for="BoxSupName" class="control-label col-md-6">There is no Supplier Name</label>
                        <input type="checkbox" id="BoxSupName" value="1">
                    </div>*@
            </div>
        </div>


        <!-- Historic Remit To -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TB_HISTORIC_REMIT1_HISTORIC_REMIT_INFO">Historic Remit To:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TB_HISTORIC_REMIT1.HISTORIC_REMIT_INFO, new { @class = "form-control", @rows = 5, @cols = 50, @disabled = "disabled" })
                        <br />
                    </div>
                </div>

                <div class="col-md-4">
                    @*<button id="ButtonAddHistoricRemit" type="button" class="styled-button align-right btn-submit" disabled>Add Historic Remit to</button>*@
                    <button id="ButtonViewHisticRemit" type="button" class="styled-button align-right openModalBtn" data-modal="ShowHistoricRemitModal">View Historic Remit to</button>
                </div>
            </div>
            <!--Modal to see historic remit -->
            <div id="ShowHistoricRemitModal" class="modal">
                <div class="modal-content">
                    <span id="cancelButton" class="close">&times;</span>
                    <div class="row">
                        <div class="control-label col-md-12">
                            <label class="control-label col-md-4" for="historicRemitInfoView">Historic Remit to:</label>
                            <div class="col-md-10">
                                <textarea class="form-control" id="historicRemitInfoView" readonly rows="6" cols="75" disabled placeholder="..."></textarea>
                                <br />
                            </div>
                        </div>
                    </div>
                    <!--Select Historic Remit to -->
                    <div class="row">
                        <div class="col-md-12">
                            <div class="col-md-6">
                                @Html.DropDownList("FK_TB_TEMPLATE_HISTORIC_REMIT_ID", null, htmlAttributes: new { @class = "form-control", @size = "5" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Our Vendor # / Account # -->
            <div class="form-group">
                <div class="row">
                    <div class="col-md-6">
                        <label class="control-label col-md-2" for="TEMP_VENDOR_ACCOUNT" id="label-OurVendorA">OUR VENDOR #/ ACCOUNT #:</label>
                        <div class="col-md-10">
                            @Html.TextAreaFor(model => model.TEMP_VENDOR_ACCOUNT, new { @class = "form-control", @rows = 5, @cols = 50, @disabled = "disabled" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Alias Section -->
    <div class="form-section">
        <div class="section-title">Alias</div>
        <!-- Alias Input and Button-->
        <div class="form-group">
            <div class=" row">
                @*<div class="col-md-6">
                        <label class="control-label col-md-2" for="form-AddAlias">Alias:</label>
                        <div class="col-md-10">
                            <input type="text" class="form-control" id="form-AddAlias" placeholder="Alias name">
                        </div>
                    </div>*@
                @*<div class="col-md-6">
                        <button id="btn-addAlias" type="button" class="styled-button align-right">Add alias</button>
                    </div>*@
            </div>
            <br />
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="FK_TB_TEMPLATE_ALIAS_ID">Alias</label>
                    <div class="col-md-7">
                        @Html.DropDownList("FK_TB_TEMPLATE_ALIAS_ID", null, htmlAttributes: new { @class = "form-control", @size = "5" })
                    </div>
                </div>
            </div>

            <!--Select Alias Dropdown-->
        </div>
    </div>
    <!--Add Alias modal-->
    @*<div id="AddAliasModal" class="modal">
            <div class="modal-content">
                <span class="close">&times;</span>
                <p><label class="control-label col-md-2" for="form-AddAlias">Alias:</label></p>
                <div>
                    <input style="margin-left: 1px" class="form-control" type="text" id="form-AddAlias" />
                </div>
                <div>
                    <br />
                    <button class="btn form_btntbWC" type="button" id="cancelButton">Cancel</button>
                    <button class="btn form_btntbWC btn-submitAlias" type="button" id="btn-submitAlias">Save</button>
                </div>
            </div>
        </div>*@
    <br />
    <!-- Oracle and Apps Section -->
    <div class="form-section">
        <div class="section-title">Oracle and Apps</div>
        <!-- Supplier Number -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_SUPPLIER_NUMBER">Supplier Number:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.TEMP_SUPPLIER_NUMBER, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                    </div>
                </div>
            </div>
        </div>
        <!-- Supplier Site -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_SUPPLIER_SITE">Supplier Site:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.TEMP_SUPPLIER_SITE, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                    </div>
                </div>
            </div>
        </div>
        <!-- Address -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_ADDRESS">Address:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TEMP_ADDRESS, new { @class = "form-control", @rows = 5, @cols = 50, @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Legal Entity -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="FK_TB_LEGAL_ENTITY_ID">Legal Entity:</label>
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_LEGAL_ENTITY_ID", null, htmlAttributes: new { @class = "form-control", @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <!-- First-Party Taxpayer ID -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_TAXPAYER_ID">Taxpayer ID:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.TEMP_TAXPAYER_ID, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                    </div>
                </div>
            </div>
        </div>
        <!-- Type -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_ORACLE_TYPE_ID, "Type:", htmlAttributes: new { @class = "control-label col-md-2 OracleText" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_ORACLE_TYPE_ID", null, htmlAttributes: new { @class = "form-control", @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Description -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2 OracleText" for="TEMP_ORACLE_DESCRIPTION">Description:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TEMP_ORACLE_DESCRIPTION, new { @class = "form-control", @rows = 5, @cols = 50, @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Pay Terms -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_ORACLE_PAY_TERMS_ID, "Pay Terms:", htmlAttributes: new { @class = "control-label col-md-2 OracleText" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_ORACLE_PAY_TERMS_ID", null, htmlAttributes: new { @class = "form-control", @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Account Coding -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_ACCOUNT_CODING">Account Coding:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.TEMP_ACCOUNT_CODING, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                    </div>
                </div>
            </div>
        </div>
        <!-- Source -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_ORACLE_SOURCE_ID, "Source:", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_ORACLE_SOURCE_ID", null, htmlAttributes: new { @class = "form-control", @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Oracle Notes -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_ORACLE_NOTES">Oracle Notes:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TEMP_ORACLE_NOTES, new { @class = "form-control", @rows = 5, @cols = 50, @disabled = "disabled" })

                    </div>
                </div>
                <!-- Oracle Instructions -->
                <div class="col-md-6">
                    <label class="control-label col-md-2 checkbox-label" for="TEMP_ORACLE_INSTRUCTIONS" id="Label-Oracle">Oracle Instructions:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TEMP_ORACLE_INSTRUCTIONS, new { @class = "form-control", @rows = 5, @cols = 50, @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Notes & Instructions Section -->
    <div class="form-section">
        <div class="section-title">Notes & Instructions</div>
        <!-- Highlights -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="TB_HIGHLIGHTS1_HIGHLIGHTS">Highlights</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TB_HIGHLIGHTS1.HIGHLIGHTS, new { @class = "form-control", @rows = 8, @cols = 150, @disabled = "disabled" })
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="col-md-10">
                        @*<button id="ButtonAddHistory" type="button" class="styled-button align-right openModalBtn" data-modal="AddAHighlights" >Add History</button>*@
                        <button id="ButtonViewHistory" type="button" class="styled-button align-right openModalBtn" data-modal="ShowHighlights">View History</button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Highlights Comments -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="TB_HIGHLIGHTS1_HIGHLIGHTS_COMMENTS">Highlights Comments:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TB_HIGHLIGHTS1.HIGHLIGHTS_COMMENTS, new { @class = "form-control", @rows = 8, @cols = 150, @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Instructions -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="TB_HIGHLIGHTS1_HIGHLIGHTS_INSTRUCTIONS">Instructions:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TB_HIGHLIGHTS1.HIGHLIGHTS_INSTRUCTIONS, new { @class = "form-control", @rows = 8, @cols = 150, @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Exceptions -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="TB_HIGHLIGHTS1_HIGHLIGHTS_EXCEPTIONS">Exceptions:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TB_HIGHLIGHTS1.HIGHLIGHTS_EXCEPTIONS, new { @class = "form-control", @rows = 8, @cols = 150, @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Most Common Issues -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="TB_HIGHLIGHTS1_HIGHLIGHTS_COMMON_ISSUES">Most Common <br> Issues:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TB_HIGHLIGHTS1.HIGHLIGHTS_COMMON_ISSUES, new { @class = "form-control", @rows = 8, @cols = 150, @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Supplier Agency -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="TB_HIGHLIGHTS1_HIGHLIGHTS_SUPPLIER_AGENCY">Supplier Agency:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TB_HIGHLIGHTS1.HIGHLIGHTS_SUPPLIER_AGENCY, new { @class = "form-control", @rows = 8, @cols = 150, @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <!-- Template Comments -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-8">
                    <label class="control-label col-md-2" for="TB_HIGHLIGHTS1_HIGHLIGHTS_TEMPLATE_COMMENTS">Template Comments:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TB_HIGHLIGHTS1.HIGHLIGHTS_TEMPLATE_COMMENTS, new { @class = "form-control", @rows = 8, @cols = 150, @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--Show Highlights modal-->
    <div id="ShowHighlights" class="modal">
        <div class="modal-content">
            <span id="cancelButton " class="close">&times;</span>
            @*Highlights*@

            <p><label class="control-label col-md-2" for="HighlightsHistoryView">Highlights</label></p>
            <textarea class="form-control" id="HighlightsHistoryView" rows="4" cols="80" disabled></textarea>

            @*Highlights Comments*@
            <p><label class="control-label col-md-2" for="HighlightsCHistoryView">Highlights Comments:</label></p>
            <textarea class="form-control" id="HighlightsCHistoryView" rows="4" cols="80" disabled></textarea>

            @*Instructions*@
            <p><label class="control-label col-md-2" for="InstructionsHistoryView">Instructions:</label></p>
            <textarea class="form-control" id="InstructionsHistoryView" rows="4" cols="80" disabled></textarea>

            @*Exceptions*@
            <p><label class="control-label col-md-2" for="ExceptionsHistoryView">Exceptions:</label></p>
            <textarea class="form-control" id="ExceptionsHistoryView" rows="4" cols="80" disabled></textarea>

            @*Most Common Issues*@
            <p><label class="control-label col-md-2" for="MostCIHistoryView">Most Common Issues:</label></p>
            <textarea class="form-control" id="MostCIHistoryView" rows="4" cols="80" disabled></textarea>

            @*Supplier Agency*@
            <p><label class="control-label col-md-2" for="SupplierAHistoryView">Supplier Agency:</label></p>
            <textarea class="form-control" id="SupplierAHistoryView" rows="4" cols="80" disabled></textarea>

            @*Template Comments*@
            <p><label class="control-label col-md-2" for="TemplateCHistoryView">Template Comments:</label></p>
            <textarea class="form-control" id="TemplateCHistoryView" rows="4" cols="80" disabled></textarea>
            <br />
            <div class="form-row">
                @Html.DropDownList("FK_TB_HIGHLIGHTS", null, htmlAttributes: new { @class = "form-control" })
            </div>
        </div>
    </div>

    <br />

    <!-- Emails Section -->
    <div class="form-section">
        <div class="section-title">Emails</div>
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-BackUpEmails">Back Up Emails:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-BackUpEmail" rows="6" cols="150" disabled placeholder="Backup email"></textarea>
                    </div>
                </div>
                @*<div class="col-md-6">
                    <button id="ButtonAddEmail" type="button" class="styled-button align-right openModalBtn" data-modal="AddEmailModal">Add Email</button>
                </div>*@
            </div>
        </div>

        <!--Select Mails Dropdown -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class=" control-label col-md-2" for="FK_TB_EMAIL_BACKUP_ID"></label>
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_EMAIL_BACKUP_ID", null, htmlAttributes: new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Approver Section -->
    <div class="form-section">
        <div class="section-title">Approver</div>
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    @Html.LabelFor(model => model.FK_TB_APPROVER_ID, "Approver:", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("FK_TB_APPROVER_ID", null, htmlAttributes: new { @class = "form-control", @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_APPROVER_COMMENTS">Aprover Comments:</label>
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.TEMP_APPROVER_COMMENTS, new { @class = "form-control", @rows = 5, @cols = 50, @disabled = "disabled" })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Invoice Number Format Section -->
    <div class="form-section">
        <div class="section-title">Invoice Number Format</div>
        <!-- Approver info -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_INVOICE_FORMAT">Invoice Format:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.TEMP_INVOICE_FORMAT, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                    </div>
                </div>
            </div>
        </div>
        <!-- Type -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="TEMP_INVOICE_TYPE">Type:</label>
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.TEMP_INVOICE_TYPE, new { htmlAttributes = new { @class = "form-control", @disabled = "disabled" } })
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />

    <!-- Cancel and Save Buttons -->
    @Html.ActionLink("Back To list", "Index")

}

@section scripts {

    <script src="~/Scripts/TemplateCrud.js"></script>
    <script src="~/Scripts/templateModal.js"></script>
    <script src="//code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="//code.jquery.com/ui/1.13.1/jquery-ui.min.js"></script>
}

