    <!--Show Highlights modal-->
    <div id="ShowHighlights" class="modal">
        <div class="modal-content">
            <span id="cancelButton " class="close">&times;</span>
            @*Highlights*@

            <p><label class="control-label col-md-2" for="HighlightsHistoryView">Highlights</label></p>
            <textarea class="form-control" id="HighlightsHistoryView" rows="4" cols="80" disabled></textarea>

            @*Highlights Comments*@
            <p><label class="control-label col-md-2" for="HighlightsCHistoryView">Highlights Comments:</label></p>
            <textarea class="form-control" id="HighlightsCHistoryView" rows="4" cols="80" disabled></textarea>

            @*Instructions*@
            <p><label class="control-label col-md-2" for="InstructionsHistoryView">Instructions:</label></p>
            <textarea class="form-control" id="InstructionsHistoryView" rows="4" cols="80" disabled></textarea>

            @*Exceptions*@
            <p><label class="control-label col-md-2" for="ExceptionsHistoryView">Exceptions:</label></p>
            <textarea class="form-control" id="ExceptionsHistoryView" rows="4" cols="80" disabled></textarea>

            @*Most Common Issues*@
            <p><label class="control-label col-md-2" for="MostCIHistoryView">Most Common Issues:</label></p>
            <textarea class="form-control" id="MostCIHistoryView" rows="4" cols="80" disabled></textarea>

            @*Supplier Agency*@
            <p><label class="control-label col-md-2" for="SupplierAHistoryView">Supplier Agency:</label></p>
            <textarea class="form-control" id="SupplierAHistoryView" rows="4" cols="80" disabled></textarea>

            @*Template Comments*@
            <p><label class="control-label col-md-2" for="TemplateCHistoryView">Template Comments:</label></p>
            <textarea class="form-control" id="TemplateCHistoryView" rows="4" cols="80" disabled></textarea>
            <br />
            <div class="form-row">
                @Html.DropDownList("FK_TB_HIGHLIGHTS", null, htmlAttributes: new { @class = "form-control" })
            </div>
        </div>
    </div>

    <br />

    <!-- Emails Section -->
    <div class="form-section">
        <div class="section-title">Emails</div>
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
                    <label class="control-label col-md-2" for="form-BackUpEmail">Back Up Emails:</label>
                    <div class="col-md-10">
                        <textarea class="form-control" id="form-BackUpEmail" rows="6" cols="150" placeholder="Backup email"></textarea>
                    </div>
                </div>
                <div class="col-md-6">
                    <button id="ButtonAddEmail" type="button" class="styled-button align-right" >Add Email</button>
                </div>
            </div>
        </div>

        <!--Select Mails Dropdown -->
        <div class="form-group">
            <div class="row">
                <div class="col-md-6">
